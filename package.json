{
  "name": "baseplate",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#domain": "./src/domain/index.ts",
    "#application": "./src/application/index.ts",
    "#infrastructure": "./src/infrastructure/index.ts",
    "#shared": "./src/shared/index.ts"
  },
  "scripts": {
    "test": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "bash tests/acceptance/two-token.sh && bash tests/acceptance/signup-login.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/delivery/dashboard/tsconfig.json",
    "lint": "eslint src tests sdk/src stack/auth/src stack/migrate/src",
    "lint:arch": "depcruise src --config dependency-cruiser.cjs",
    "cli": "tsx src/delivery/cli/main.ts",
    "dashboard": "tsx src/delivery/operator-http/listen.ts",
    "sdk:types": "tsx sdk/scripts/gen-types.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  }
}
