{$SITE_ADDRESS} {
	header Access-Control-Allow-Origin *
	header Access-Control-Allow-Headers "Authorization, Content-Type, Prefer, Accept"
	header Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, OPTIONS"
	@options {
		method OPTIONS
	}
	handle @options {
		respond 204
	}
	handle /auth* {
		reverse_proxy auth:3001
	}
	handle {
		reverse_proxy postgrest:3000
	}
}
