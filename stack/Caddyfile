{$SITE_ADDRESS} {
	# PostgREST sets its own Access-Control-Allow-Origin, so these have to be
	# applied to the response on the way out and replace what is already there.
	# Without `defer` the header is sent twice and every browser rejects it.
	header {
		defer
		Access-Control-Allow-Origin "{$CORS_ORIGIN:*}"
		Access-Control-Allow-Headers "Authorization, Content-Type, Prefer, Accept, Range"
		Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, OPTIONS"
		Access-Control-Max-Age "600"
		Vary "Origin"
	}
	@options {
		method OPTIONS
	}
	handle @options {
		respond 204
	}
	# Matched on whole path segments. `/auth*` also matches `/authors`, so a
	# table with a name starting `auth` would be answered by the auth service
	# instead of the API, and the operator would see a baffling 404.
	@auth path /auth /auth/*
	handle @auth {
		reverse_proxy auth:3001
	}
	@storage path /storage /storage/*
	handle @storage {
		reverse_proxy storage:3002
	}
	handle {
		reverse_proxy postgrest:3000
	}
}
