TARGET=local
JWT_SECRET=dev-jwt-secret-must-be-at-least-32-chars
POSTGRES_PASSWORD=devpostgrespass
AUTHENTICATOR_PASSWORD=devauthenticatorpass
AUTH_SERVICE_PASSWORD=devauthservicepass
HTTP_PORT=8080
SITE_ADDRESS=:8080

# Hetzner is BYOK. These are YOUR account credentials.
# Baseplate has no cloud account. Set TARGET=hetzner to use them.
# Also set stack/stack.json hostname to an FQDN under HETZNER_DNS_ZONE,
# and set SITE_ADDRESS to that same hostname (required for Caddy TLS).
HCLOUD_TOKEN=
HETZNER_DNS_TOKEN=
HETZNER_DNS_ZONE=
SSH_KEY_NAME=
SERVER_LOCATION=nbg1
